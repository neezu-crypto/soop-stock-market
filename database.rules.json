      },
      "commentReports": {
        ".read": "auth != null && root.child('adminCenter/adminUids').child(auth.uid).exists()",
        ".indexOn": ["commentId", "createdAt"],
        "$reportId": { ".write": false }
      },
      "commentReportsByUser": {
        ".read": false,
        "$uid": { ".write": false }
      },
      "streamerFirstUpload": {
        ".read": true,
        "$streamerId": { ".write": false }
      },
      "streamerUnlockedUntil": {
        ".read": true,
        "$streamerId": { ".write": false }
      },
      "unlockRequests": {
        ".read": "auth != null && root.child('adminCenter/adminUids').child(auth.uid).exists()",
        ".indexOn": ["streamerId"],
        "$requestId": { ".write": false }
      },
      "auditLog": {
        ".read": "auth != null && root.child('adminCenter/adminUids').child(auth.uid).exists()",
        "$entryId": { ".write": false }
      }
    }
  }
}
